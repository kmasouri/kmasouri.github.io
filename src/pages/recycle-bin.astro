---
import Desktop from '../layouts/Desktop.astro';
import XPWindow from '../components/XPWindow.astro';
import ExplorerToolbar from '../components/ExplorerToolbar.astro';

const icon = '/icons/recycle-bin.png';
const items = [
  { name: 'blog-export-FINAL-final.zip', from: 'C:\\My Documents', icon: '/icons/folder.png' },
  { name: 'blog-redesign-v1 (abandoned).html', from: 'C:\\My Documents\\Projects', icon: '/icons/page.png' },
  { name: 'untitled-draft-47.txt', from: 'C:\\Desktop', icon: '/icons/notepad.png' },
  { name: 'New Folder (7)', from: 'C:\\Desktop', icon: '/icons/folder.png' },
];
---

<Desktop title="Recycle Bin" description="Things that didn't make the cut." noindex tasks={[{ id: 'bin-window', title: 'Recycle Bin', icon }]}>
  <XPWindow id="bin-window" title="Recycle Bin" icon={icon} width="620px">
    <div slot="chrome">
      <div class="menubar" aria-hidden="true"><span>File</span><span>Edit</span><span>View</span><span>Favorites</span><span>Tools</span><span>Help</span></div>
      <ExplorerToolbar back="/" up="/">
        <span class="tb-sep" aria-hidden="true"></span>
        <button type="button" data-empty-bin>Empty Recycle Bin</button>
      </ExplorerToolbar>
    </div>
    <div class="file-pane">
      <h1>Recycle Bin</h1>
      <ul class="file-list" data-bin-list>
        {
          items.map((item) => (
            <li>
              <img src={item.icon} alt="" width="40" height="40" />
              <span class="file-title">{item.name}</span>
              <p class="file-desc">Original location: {item.from}</p>
            </li>
          ))
        }
      </ul>
      <p class="empty-note" data-bin-empty hidden>The Recycle Bin is empty.</p>
    </div>
    <div slot="status" class="status-bar">
      <p class="status-bar-field" data-bin-count>{items.length} object(s)</p>
    </div>
  </XPWindow>
</Desktop>

<script>
  // Runs on every visit: pages swap in place, so module code only runs once.
  document.addEventListener('astro:page-load', () => {
    const button = document.querySelector<HTMLButtonElement>('[data-empty-bin]');
    button?.addEventListener('click', () => {
      document.querySelector('[data-bin-list]')?.remove();
      document.querySelector<HTMLElement>('[data-bin-empty]')!.hidden = false;
      document.querySelector('[data-bin-count]')!.textContent = '0 object(s)';
      button.disabled = true;
    });
  });
</script>

<style>
  html:not(.js) [data-empty-bin] {
    display: none;
  }
</style>
