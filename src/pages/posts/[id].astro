---
import { render } from 'astro:content';
import Desktop from '../../layouts/Desktop.astro';
import XPWindow from '../../components/XPWindow.astro';
import BrowserChrome from '../../components/BrowserChrome.astro';
import { formatDate, getPosts, postUrl, readingTime, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  // posts are newest first: "newer" is the previous item, "older" the next
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, description, date, tags } = post.data;
const url = new URL(postUrl(post), Astro.site).href;
const icon = '/icons/page.png';
---

<Desktop
  title={title}
  description={description}
  article={{ published: date, tags }}
  tasks={[{ id: 'post-window', title, icon }]}
>
  <XPWindow id="post-window" title={`${title} - Internet Explorer`} icon={icon} width="860px" height="calc(100% - 48px)" closeHref="/posts/">
    <div slot="chrome">
      <BrowserChrome back="/posts/" path={postUrl(post)} url={url} />
    </div>

    <article class="prose">
      <header>
        <h1>{title}</h1>
        <div class="post-meta">
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
          <span>{readingTime(post.body)}</span>
          {
            tags.length > 0 && (
              <ul class="tag-list" aria-label="Tags">
                {tags.map((tag) => (
                  <li class="tag">{tag}</li>
                ))}
              </ul>
            )
          }
        </div>
      </header>

      <Content />

      {
        (newer || older) && (
          <nav class="post-nav" aria-label="More posts">
            <div>
              {older && (
                <a href={postUrl(older)} rel="prev">
                  <small>&larr; Older</small>
                  {older.data.title}
                </a>
              )}
            </div>
            <div class="next">
              {newer && (
                <a href={postUrl(newer)} rel="next">
                  <small>Newer &rarr;</small>
                  {newer.data.title}
                </a>
              )}
            </div>
          </nav>
        )
      }
    </article>

    <div slot="status" class="status-bar ie-status">
      <p class="status-bar-field"><img src="/icons/page.png" alt="" width="16" height="16" />Done</p>
      <p class="status-bar-field" aria-hidden="true"></p>
      <p class="status-bar-field" aria-hidden="true"></p>
      <p class="status-bar-field"><img src="/icons/globe.png" alt="" width="16" height="16" />Internet</p>
    </div>
  </XPWindow>
</Desktop>
