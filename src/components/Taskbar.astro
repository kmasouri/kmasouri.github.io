---
import { AUTHOR, EMAIL, GITHUB_URL, SITE_TITLE } from '../consts';
import { getPosts, postUrl } from '../lib/posts';

export interface Task {
  /** id of the window element this button controls */
  id: string;
  title: string;
  icon: string;
}

interface Props {
  tasks: Task[];
  /** Pop the welcome balloon up on load (the home page). */
  welcome?: boolean;
}

const { tasks, welcome = false } = Astro.props;
const recent = (await getPosts()).slice(0, 5);
const latest = recent.slice(0, 3);
---

<footer class="taskbar" aria-label="Taskbar">
  <button class="start-button" type="button" popovertarget="start-menu">
    <img src="/icons/logo-placeholder.svg" alt="" width="20" height="20" />
    <span>start</span>
  </button>

  <div id="start-menu" class="start-menu" popover>
    <div class="start-header">
      <img src="/icons/avatar-placeholder.svg" alt="" width="48" height="48" />
      <span>{AUTHOR}</span>
    </div>
    <nav class="start-body" aria-label="Start menu">
      <div class="start-left">
        <ul>
          <li><a href="/posts/"><img src="/icons/folder.png" alt="" width="32" height="32" /><span>My Blog</span></a></li>
          <li><a href="/about/"><img src="/icons/notepad.png" alt="" width="32" height="32" /><span>About Me</span></a></li>
        </ul>
        {
          recent.length > 0 && (
            <>
              <hr class="start-sep" />
              <ul aria-label="Recent posts">
                {recent.map((post) => (
                  <li>
                    <a href={postUrl(post)}><img src="/icons/page.png" alt="" width="32" height="32" /><span>{post.data.title}</span></a>
                  </li>
                ))}
              </ul>
            </>
          )
        }
        <div class="start-all">
          <hr class="start-sep" />
          <a href="/posts/"><span>All Posts</span><span class="start-arrow" aria-hidden="true"></span></a>
        </div>
      </div>
      <div class="start-right">
        <ul>
          <li><a href={GITHUB_URL} rel="me noopener"><img src="/icons/globe.png" alt="" width="24" height="24" /><span>GitHub</span></a></li>
          <li><a href={`mailto:${EMAIL}`}><img src="/icons/mail.png" alt="" width="24" height="24" /><span>E-mail Me</span></a></li>
        </ul>
        <hr class="start-sep" />
        <ul>
          <li><a href="/recycle-bin/"><img src="/icons/recycle-bin.png" alt="" width="24" height="24" /><span>Recycle Bin</span></a></li>
        </ul>
      </div>
    </nav>
    <div class="start-footer">
      <a href="/welcome/"><img src="/icons/log-off.png" alt="" width="24" height="24" /><span>Log Off</span></a>
      <a href="/" data-astro-reload data-turn-off><img src="/icons/power.png" alt="" width="24" height="24" /><span>Turn Off Computer</span></a>
    </div>
  </div>

  <!-- XP's "Turn off computer" box. Opened by the Start menu's Turn Off link. -->
  <dialog id="turn-off" class="turnoff" aria-labelledby="turn-off-title">
    <h2 id="turn-off-title" class="turnoff-head">Turn off computer</h2>
    <div class="turnoff-body">
      <button type="button" class="turnoff-choice" data-power="standby">
        <svg class="turnoff-icon is-standby" viewBox="0 0 32 32" aria-hidden="true"><rect x="1" y="1" width="30" height="30" rx="5" /><path d="M11 10.5a8 8 0 1 0 10 0M16 7v9" /></svg>
        <span>Stand By</span>
      </button>
      <button type="button" class="turnoff-choice" data-power="off" autofocus>
        <svg class="turnoff-icon is-off" viewBox="0 0 32 32" aria-hidden="true"><rect x="1" y="1" width="30" height="30" rx="5" /><circle cx="16" cy="16" r="9" /><path d="M16 9.5v8" /></svg>
        <span>Turn Off</span>
      </button>
      <button type="button" class="turnoff-choice" data-power="restart">
        <svg class="turnoff-icon is-restart" viewBox="0 0 32 32" aria-hidden="true"><rect x="1" y="1" width="30" height="30" rx="5" /><path d="M23 12a8 8 0 1 0 1 6" /><path d="M24.5 7v5.5H19" /></svg>
        <span>Restart</span>
      </button>
    </div>
    <div class="turnoff-foot">
      <button type="button" data-power="cancel">Cancel</button>
    </div>
  </dialog>

  <!-- Black "monitor off" screen for Stand By and Turn Off. -->
  <div class="power-screen" data-power-screen hidden>
    <p data-power-title></p>
    <p data-power-hint></p>
  </div>

  <ul class="task-list" aria-label="Open windows">
    {
      tasks.map((task) => (
        <li>
          <button class="task-button" type="button" data-task={task.id} aria-controls={task.id} aria-pressed="true">
            <img src={task.icon} alt="" width="16" height="16" />
            <span>{task.title}</span>
          </button>
        </li>
      ))
    }
  </ul>

  <div class="tray">
    <button type="button" class="tray-icon" data-balloon-toggle aria-controls="welcome-balloon" aria-expanded={String(welcome)} title="Welcome">
      <img src="/icons/tray-info.png" alt="Welcome message" width="16" height="16" />
    </button>
    <span class="tray-icon" title="Local Area Connection: Connected"><img src="/icons/tray-network.png" alt="Network: connected" width="16" height="16" /></span>
    <span class="tray-icon" title="Volume"><img src="/icons/tray-volume.png" alt="Volume" width="16" height="16" /></span>
    <time class="clock" id="clock"></time>
  </div>

  <!-- Welcome balloon: comes from the info icon in the tray. -->
  <aside class="balloon" id="welcome-balloon" data-balloon aria-labelledby="welcome-title" hidden={!welcome}>
    <button type="button" class="balloon-close" data-balloon-close aria-label="Dismiss welcome message">&times;</button>
    <h2 id="welcome-title"><img src="/icons/tray-info.png" alt="" width="16" height="16" /> Welcome to {SITE_TITLE}</h2>
    <p>Open <a href="/posts/">My Blog</a> to read posts, or click <strong>start</strong> to look around.</p>
    {
      latest.length > 0 && (
        <>
          <p>Latest:</p>
          <ul>
            {latest.map((post) => (
              <li>
                <a href={postUrl(post)}>{post.data.title}</a>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </aside>
</footer>
