---
/**
 * Internet Explorer 6's chrome for post windows: menu bar, Standard Buttons
 * (Back, Forward, Stop, Refresh, Home | Search, Favorites, History | Print)
 * and the Address bar with Go and Links. Back and Forward follow your history
 * on the site (see desktop.ts); Refresh, Home, Go and Print work; the rest are
 * decorative, like the menu bar.
 */
interface Props {
  /** Where Back goes. */
  back: string;
  /** The page's own path (Refresh and Go). */
  path: string;
  /** Full URL shown in the Address bar. */
  url: string;
}

const { back, path, url } = Astro.props;
---

<div class="menubar" aria-hidden="true"><span>File</span><span>Edit</span><span>View</span><span>Favorites</span><span>Tools</span><span>Help</span></div>

<nav class="toolbar xp-toolbar ie-toolbar" aria-label="Browser">
  <a class="tb-btn" href={back} data-history="back">
    <img src="/icons/tb-back.png" alt="" width="24" height="24" />
    <span>Back</span><span class="tb-caret" aria-hidden="true"></span>
  </a>
  <button class="tb-btn is-off" type="button" data-history="forward" aria-label="Forward" disabled>
    <img src="/icons/tb-forward.png" alt="" width="24" height="24" />
    <span class="tb-caret" aria-hidden="true"></span>
  </button>
  <span class="tb-btn is-deco" aria-hidden="true" title="Stop">
    <img src="/icons/tb-stop.png" alt="" width="24" height="24" />
  </span>
  <a class="tb-btn" href={path} title="Refresh">
    <img src="/icons/tb-refresh.png" alt="" width="24" height="24" />
    <span class="sr-only">Refresh</span>
  </a>
  <a class="tb-btn" href="/" title="Home"><img src="/icons/tb-home.png" alt="" width="24" height="24" /><span class="sr-only">Home</span></a>
  <span class="tb-sep" aria-hidden="true"></span>
  <span class="tb-btn is-deco" aria-hidden="true"><img src="/icons/tb-search.png" alt="" width="24" height="24" /><span>Search</span></span>
  <span class="tb-btn is-deco" aria-hidden="true"><img src="/icons/tb-favorites.png" alt="" width="24" height="24" /><span>Favorites</span></span>
  <span class="tb-btn is-deco" aria-hidden="true" title="History"><img src="/icons/tb-history.png" alt="" width="24" height="24" /></span>
  <span class="tb-sep" aria-hidden="true"></span>
  <button class="tb-btn" type="button" data-print title="Print"><img src="/icons/tb-print.png" alt="" width="24" height="24" /><span class="sr-only">Print</span></button>
</nav>

<div class="addressbar ie-addressbar">
  <label for="address">Address</label>
  <span class="ie-address">
    <img src="/icons/page.png" alt="" width="16" height="16" />
    <input id="address" type="text" readonly value={url} data-address />
    <span class="ie-drop" aria-hidden="true"></span>
  </span>
  <a class="ie-go" href={path}>
    <img src="/icons/icon-placeholder.svg" alt="" width="18" height="18" />
    <span>Go</span>
  </a>
  <span class="ie-links" aria-hidden="true">Links <span>&raquo;</span></span>
</div>
