---
/**
 * XP Explorer's standard buttons: Back, Forward, Up | Search, Folders | Views.
 * Back and Forward follow your history on the site (desktop.ts greys them out
 * until there is somewhere to go); without JavaScript, Back links to `back`.
 * Up, Search and Views are decorative, like the menu bar. Folders hides or
 * shows the task pane when the window has one.
 *
 * Slot: extra buttons, added after the standard ones.
 */
interface Props {
  back: string;
  label?: string;
  /** Enable the Folders button (the window has a .task-pane). */
  folders?: boolean;
}

const { back, label = 'Folder', folders = false } = Astro.props;
---

<nav class="toolbar xp-toolbar" aria-label={label}>
  <a class="tb-btn" href={back} data-history="back">
    <img src="/icons/tb-back.png" alt="" width="24" height="24" />
    <span>Back</span><span class="tb-caret" aria-hidden="true"></span>
  </a>
  <button class="tb-btn is-off" type="button" data-history="forward" aria-label="Forward" disabled>
    <img src="/icons/tb-forward.png" alt="" width="24" height="24" />
    <span class="tb-caret" aria-hidden="true"></span>
  </button>
  <span class="tb-btn is-deco" aria-hidden="true" title="Up"><img src="/icons/tb-up.png" alt="" width="24" height="24" /></span>
  <span class="tb-sep" aria-hidden="true"></span>
  <span class="tb-btn is-deco" aria-hidden="true"><img src="/icons/tb-search.png" alt="" width="24" height="24" /><span>Search</span></span>
  {
    folders ? (
      <button class="tb-btn" type="button" data-toggle-tasks aria-pressed="false">
        <img src="/icons/tb-folders.png" alt="" width="24" height="24" />
        <span>Folders</span>
      </button>
    ) : (
      <span class="tb-btn is-deco" aria-hidden="true">
        <img src="/icons/tb-folders.png" alt="" width="24" height="24" />
        <span>Folders</span>
      </span>
    )
  }
  <span class="tb-sep" aria-hidden="true"></span>
  <span class="tb-btn is-deco" aria-hidden="true">
    <img src="/icons/tb-views.png" alt="" width="24" height="24" />
    <span class="tb-caret"></span>
  </span>
  <slot />
</nav>
